{
  "name": "@covennetwork/kit",
  "version": "0.1.0",
  "description": "Wallet connection, account and swap views for any EVM app, as Web Components with a React wrapper. Defaults to Arc.",
  "license": "MIT",
  "homepage": "https://docs.coven.network/guides/kit/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/covennetwork/kit.git"
  },
  "keywords": [
    "wallet",
    "connect",
    "wagmi",
    "evm",
    "swap",
    "arc",
    "usdc",
    "web-components",
    "coven"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/elements.js",
    "./dist/react.js",
    "./dist/cdn/*",
    "./src/elements.ts",
    "./src/react.tsx"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./elements": {
      "types": "./dist/elements.d.ts",
      "default": "./dist/elements.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./iframe": {
      "types": "./dist/iframe.d.ts",
      "default": "./dist/iframe.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/gen-chains.mjs && tsup && node scripts/build-cdn.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "demo": "vite --config demo/vite.config.ts",
    "demo:build": "vite build --config demo/vite.config.ts --outDir ../demo-dist --emptyOutDir",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "viem": "2.x"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@coinbase/wallet-sdk": "^4.4.0",
    "@covennetwork/sdk": "^0.3.1",
    "@metamask/connect-evm": "^2.1.1",
    "@safe-global/safe-apps-provider": "^0.18.6",
    "@safe-global/safe-apps-sdk": "^9.1.0",
    "@wagmi/connectors": "8.2.0",
    "@wagmi/core": "3.6.5",
    "@walletconnect/ethereum-provider": "^2.26.0",
    "lit": "^3.3.3",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "esbuild": "^0.28.2",
    "happy-dom": "^21.0.1",
    "playwright-core": "^1.64.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "viem": "^2.57.6",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
