// The playground (demo/), served as static assets at kit.coven.network.
// Build with `npm run demo:build`, then `npx wrangler deploy`.
{
  "name": "coven-kit",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./demo-dist", "not_found_handling": "single-page-application" },
  "routes": [{ "pattern": "kit.coven.network", "custom_domain": true }]
}
